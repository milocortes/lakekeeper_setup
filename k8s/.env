export OPENFGA_DATASTORE_ENGINE=postgres
export OPENFGA_DATASTORE_URI=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
export OPENFGA_DATASTORE_MAX_OPEN_CONNS=200
export OPENFGA_DATASTORE_MAX_IDLE_CONNS=100
export OPENFGA_PLAYGROUND_ENABLED=false
export OPENFGA_AUTHN_METHOD=oidc
export OPENFGA_AUTHN_OIDC_ISSUER=http://localhost:30080/realms/iceberg
export OPENFGA_AUTHN_OIDC_ISSUER_ALIASES=http://localhost:30080/realms/iceberg
export OPENFGA_AUTHN_OIDC_AUDIENCE=openfga
export OPENFGA_HTTP_TLS_ENABLED=false
export OPENFGA_CACHE_CONTROLLER_ENABLED=true
export OPENFGA_CHECK_QUERY_CACHE_ENABLED=true
export OPENFGA_CHECK_ITERATOR_CACHE_ENABLED=true 